{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with balance, VIP status, role, custom ID, and statistics",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "customId": { "type": "string", "maxLength": 32 },
        "email": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["admin", "player"] },
        "balance": { "type": "number" },
        "totalWinnings": { "type": "number" },
        "totalBets": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "customId", "displayName", "balance", "role"]
    },
    "GameRoundHistory": {
      "title": "GameRoundHistory",
      "description": "Historical record of completed Teen Patti rounds",
      "type": "object",
      "properties": {
        "roundId": { "type": "string", "maxLength": 128 },
        "roundNumber": { "type": "number" },
        "winningSpot": { "type": "string", "maxLength": 10 },
        "winningHandName": { "type": "string", "maxLength": 50 },
        "totalPot": { "type": "number" },
        "timestamp": { "type": "number" }
      },
      "required": ["roundId", "roundNumber", "winningSpot", "winningHandName", "totalPot", "timestamp"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial ledger record of bets, wins, and top-ups",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "type": { "type": "string", "enum": ["BET", "WIN", "RECHARGE", "REFUND"] },
        "amount": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "roundNumber": { "type": "number" },
        "timestamp": { "type": "number" },
        "description": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "userId", "type", "amount", "balanceAfter", "timestamp"]
    },
    "GameSettings": {
      "title": "GameSettings",
      "description": "Centralized system configuration for the game table",
      "type": "object",
      "properties": {
        "isGameEnabled": { "type": "boolean" },
        "defaultChips": { "type": "string" },
        "roundCountdownSeconds": { "type": "number" },
        "minBet": { "type": "number" },
        "maxBet": { "type": "number" },
        "autoFillBots": { "type": "boolean" },
        "defaultPlayerBalance": { "type": "number" }
      },
      "required": ["isGameEnabled", "minBet", "maxBet"]
    },
    "WithdrawalRequest": {
      "title": "WithdrawalRequest",
      "description": "User withdrawal of casino profits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "customId": { "type": "string" },
        "userName": { "type": "string" },
        "coinsAmount": { "type": "number" },
        "usdAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "accountDetails": { "type": "string" },
        "recipientName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "coinsAmount", "usdAmount", "paymentMethod", "accountDetails", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time user chat and gift exchange",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "gift", "system"] },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "senderId", "senderName", "content", "type", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores user balances and player profiles"
    },
    "/game_history/{roundId}": {
      "schema": "GameRoundHistory",
      "description": "Stores permanent game history for all rounds played"
    },
    "/transactions/{txId}": {
      "schema": "Transaction",
      "description": "Stores immutable financial transactions and bet logs"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "WithdrawalRequest",
      "description": "Stores user withdrawal requests"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Stores chat messages and gift events"
    },
    "/system_config/{configId}": {
      "schema": "GameSettings",
      "description": "Stores game configuration and administrative rules"
    }
  }
}
